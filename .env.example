# ==============================================================================
# CVAI SaaS — Environment Variables Template
# Copy this file to .env and replace the values with your credentials.
# ==============================================================================

# --- Django Core ---
SECRET_KEY=django-insecure-change-me-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- AI Microservice Configuration ---
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=generate-a-secure-random-token-here

# --- LLM API Keys ---
GROQ_API_KEY=gsk_your_groq_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# --- Stripe Monetization (Test or Live Keys) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_ELITE=price_...

# --- Storage Settings (Supabase / AWS S3) ---
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=cvai-media
AWS_S3_REGION_NAME=eu-central-1
AWS_S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3

# --- Monitoring (Optional) ---
SENTRY_DSN=
