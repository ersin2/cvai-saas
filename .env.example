# ==============================================================================
# CVAI SaaS — Environment Variables Template
# Copy this file to .env and replace the values with your credentials.
# ==============================================================================

# --- Django Core ---
SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- AI Microservice Configuration ---
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=your_internal_shared_secret_token_here

# --- LLM API Keys ---
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Stripe Monetization ---
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PRICE_ID_PRO=your_stripe_price_id_pro_here
STRIPE_PRICE_ID_ELITE=your_stripe_price_id_elite_here

# --- Storage Settings (Supabase / AWS S3) ---
USE_S3=False
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_STORAGE_BUCKET_NAME=your_storage_bucket_name_here
AWS_S3_REGION_NAME=eu-central-1
AWS_S3_ENDPOINT_URL=your_s3_endpoint_url_here

# --- Monitoring (Optional) ---
SENTRY_DSN=
